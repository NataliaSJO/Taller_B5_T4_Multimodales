# Filtro con IA: auto (GPU si la hay, si no CPU), gpu (Gemma 3 4B), local (Gemma 3 1B en CPU),
# claude u off (solo reglas)
AI_FILTER=auto

# Solo para AI_FILTER=claude. Deshabilitado por defecto; consume tokens de pago.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Con Claude, permite al asesor buscar en la web datos de los fondos candidatos (on/off)
ADVISOR_WEB=off

# Tamaño de Whisper (small por defecto). Tras cambiarlo: python scripts/download_models.py
WHISPER_MODEL=small
